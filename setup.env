# Default settings for `make run`. Override any value ad hoc, for example:
#   make run ZOOM=50 TARGET=face BLUR=5
# Keep values as plain KEY=value so make and sh can both read this file.
# Folder of private input images and local output video.
INPUT_DIR=images
OUTPUT=output.mp4
# Ordering: name, date, or random.
ORDER=random
# Zoom added over each image, as a percentage.
ZOOM=30
# Focus point: chest (BlazePose, default) or face.
TARGET=chest
# Set to 1 to frame the full chest area when both shoulders are reliable.
# This zooms from the full image to the chest and ignores ZOOM and MAX_UPSCALE.
FULL_CHEST=1
# Seconds to hold the final chest-width frame before crossfading.
CHEST_HOLD_SECONDS=0.5
# Initial target height as a percentage of the frame; 0 disables initial zoom.
START_TARGET_SIZE=40
# Prevent excessive enlargement of low-resolution photos.
MAX_UPSCALE=3.0
# Number of images used to identify the person.
SCAN=5
# Set after viewing people.jpg to skip the prompt; leave empty to choose interactively.
PERSON=1
# Blur strength as a percentage of image size; 0 disables it.
BLUR=3
# Duration of every source image in seconds.
SECONDS_PER_IMAGE=5
